# Normaliza quebras de linha: LF no repositório, nativo no working tree.
* text=auto

# Scripts do PowerShell precisam de CRLF em algumas versões do Windows.
*.ps1 text eol=crlf

# Sempre LF, independente do sistema.
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.spec text eol=lf

# Binários: nunca converter.
*.ico binary
*.png binary
*.jpg binary
*.pdf binary
*.exe binary
